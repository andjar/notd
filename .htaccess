# Apache configuration for notd. Works in the web root and in a sub-folder.
# (PHP's built-in server ignores this file; use `php -S localhost:8000 router.php`.)

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Private: repository internals, local settings, library code, dot files.
    RewriteRule ^(docs|\.git|\.github|\.cursor)(/|$) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule ^(config(\.local)?(\.example)?\.php|router\.php|composer\.(json|lock))$ - [F,L,NC]
    RewriteRule ^api/[^/]+\.php$ - [F,L,NC]
    RewriteRule ^assets/template/.*\.php$ - [F,L,NC]

    # Nothing in uploads/ is ever executed.
    RewriteRule ^uploads/.*\.(php\d?|phtml|phar)$ - [F,L,NC]

    # /api/v1/pages works as well as /api/v1/pages.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^api/v1/([A-Za-z0-9_-]+)$ api/v1/$1.php [L]
</IfModule>

# db/ and tests/ carry their own .htaccess that denies everything.
