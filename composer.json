{
    "name": "notd/outliner",
    "description": "A small outliner application in PHP+JS+SQLite for offline use",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "api/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "node tests/js/model.test.mjs && node tests/js/ordering_parity.mjs",
        "test:api": "node tests/js/ops_api.test.mjs",
        "test:browser": "python3 tests/browser/outline_test.py",
        "test:unit": "vendor/bin/phpunit tests/",
        "migrate": "php db/migrate_v3.php"
    }
}
